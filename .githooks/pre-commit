#!/bin/sh
KICAD_CLI="/Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli"

find . -name "*.kicad_sch" -not -path "./.history/*" -not -path "*-backups/*" | while read -r sch; do
  svg="${sch%.kicad_sch}.svg"
  "$KICAD_CLI" sch export svg --output "$(dirname "$sch")" "$sch" 2>/dev/null || exit 1
  git add "$svg"
done
